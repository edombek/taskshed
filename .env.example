# Alternative to config.yaml — every key can be supplied via environment.
# Nested config.yaml keys map to TASKSHED_<SECTION>_<KEY> (upper snake case).

# Telegram (Telethon bot mode)
TASKSHED_TELEGRAM_API_ID=
TASKSHED_TELEGRAM_API_HASH=
TASKSHED_TELEGRAM_BOT_TOKEN=
# MTProto proxy
TASKSHED_TELEGRAM_PROXY_IP=
TASKSHED_TELEGRAM_PROXY_PORT=
TASKSHED_TELEGRAM_PROXY_SECRET=

# VK community bot
TASKSHED_VK_GROUP_TOKEN=
TASKSHED_VK_GROUP_ID=
TASKSHED_VK_PROXY_URL=

# Database
TASKSHED_DATABASE_URL=sqlite+aiosqlite:///taskshed.db
